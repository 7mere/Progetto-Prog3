<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unito.client.InboxController">

    <!-- TOP BAR: info utente + stato connessione -->
    <top>
        <VBox spacing="10.0" styleClass="top-container" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="14.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
                <Label styleClass="app-title" text="Mail Client">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Label styleClass="muted" text="Loggato come:" />
                <Label fx:id="userEmailLabel" styleClass="user-email" text="-" />

                <Separator orientation="VERTICAL" prefHeight="22.0" />

                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="connection-box">
                    <Circle fx:id="connectionDot" radius="6.0" styleClass="connection-dot" />
                    <Label fx:id="connectionStatusLabel" styleClass="connection-text" text="NON CONNESSO" />
                </HBox>
            </HBox>

            <!-- Banner notifiche -->
            <HBox fx:id="notificationBar" alignment="CENTER_LEFT" managed="false" spacing="10.0" styleClass="notification-bar" visible="false">
                <padding>
                    <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                </padding>
                <Label fx:id="notificationLabel" styleClass="notification-text" text="Hai ricevuto un nuovo messaggio!" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="dismissNotificationButton" onAction="#onDismissNotificationClick" styleClass="btn" text="OK" />
            </HBox>

            <!-- Area errori -->
            <Label fx:id="errorLabel" managed="false" styleClass="error-label" text="" visible="false" />
        </VBox>
    </top>

    <!-- CENTER: SplitPane -->
    <center>
        <SplitPane dividerPositions="0.38" styleClass="main-split" BorderPane.alignment="CENTER">
            <items>

                <!-- LEFT: lista messaggi -->
                <VBox spacing="10.0" styleClass="card">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="section-title" text="Inbox">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label styleClass="muted" text="Ultimo aggiornamento:" />
                        <Label fx:id="lastUpdateLabel" styleClass="strong" text="-" />
                    </HBox>

                    <TableView fx:id="messageTable" styleClass="message-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFrom" prefWidth="160.0" text="Da" />
                            <TableColumn fx:id="colSubject" prefWidth="220.0" text="Oggetto" />
                            <TableColumn fx:id="colDate" prefWidth="130.0" text="Data" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button fx:id="deleteButton" disable="true" onAction="#onDeleteClick" styleClass="btn-danger" text="Elimina" />
                        <Button fx:id="replyButton" disable="true" onAction="#onReplyClick" styleClass="btn" text="Reply" />
                        <Button fx:id="replyAllButton" disable="true" onAction="#onReplyAllClick" styleClass="btn" text="Reply-All" />
                        <Button fx:id="forwardButton" disable="true" onAction="#onForwardClick" styleClass="btn" text="Forward" />
                    </HBox>
                </VBox>

                <!-- RIGHT: dettagli + composer -->
                <VBox spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>

                    <TabPane fx:id="rightTabPane" styleClass="right-tabs" VBox.vgrow="ALWAYS">
                        <tabs>

                            <!-- Dettagli -->
                            <Tab closable="false" text="Dettagli">
                                <BorderPane>
                                    <top>
                                        <VBox spacing="8.0">
                                            <Label styleClass="section-title" text="Messaggio selezionato">
                                                <font>
                                                    <Font size="16.0" />
                                                </font>
                                            </Label>

                                            <GridPane hgap="10.0" vgap="8.0">
                                                <columnConstraints>
                                                    <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" />
                                                </columnConstraints>

                                                <Label styleClass="field-label" text="Da:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                <Label fx:id="detailFromLabel" styleClass="field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                <Label styleClass="field-label" text="A:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                <Label fx:id="detailToLabel" styleClass="field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label styleClass="field-label" text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                <Label fx:id="detailDateLabel" styleClass="field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label styleClass="field-label" text="Oggetto:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                <Label fx:id="detailSubjectLabel" styleClass="field-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <rowConstraints>
                                       <RowConstraints />
                                       <RowConstraints />
                                       <RowConstraints />
                                       <RowConstraints />
                                    </rowConstraints>
                                            </GridPane>
                                        </VBox>
                                    </top>

                                    <center>
                                        <TextArea fx:id="detailBodyArea" editable="false" promptText="Seleziona un messaggio dalla lista per visualizzarne il contenuto..." styleClass="detail-body" wrapText="true" />
                                    </center>

                                    <bottom>
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <Button fx:id="composeNewButton" onAction="#onComposeNewClick" styleClass="btn-primary" text="Nuovo messaggio" />
                                        </HBox>
                                    </bottom>

                                    <padding>
                                        <Insets bottom="0.0" left="0.0" right="0.0" top="10.0" />
                                    </padding>
                                </BorderPane>
                            </Tab>

                            <!-- Scrivi -->
                            <Tab closable="false" text="Scrivi">
                                <VBox spacing="10.0">
                                    <Label styleClass="section-title" text="Componi messaggio">
                                        <font>
                                            <Font size="16.0" />
                                        </font>
                                    </Label>

                                    <Label fx:id="composeModeLabel" styleClass="compose-mode" text="Modalità: NUOVO" />

                                    <GridPane hgap="10.0" vgap="10.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="70.0" prefWidth="70.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label styleClass="field-label" text="To:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="toField" promptText="dest1@example.com, dest2@example.com" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label styleClass="field-label" text="Cc:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="ccField" promptText="(opzionale) destinatari in copia" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label styleClass="field-label" text="Oggetto:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="subjectField" promptText="Oggetto..." styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              <rowConstraints>
                                 <RowConstraints />
                                 <RowConstraints />
                                 <RowConstraints />
                              </rowConstraints>
                                    </GridPane>

                                    <TextArea fx:id="bodyArea" promptText="Scrivi qui il messaggio..." styleClass="compose-body" wrapText="true" VBox.vgrow="ALWAYS" />

                                    <Label fx:id="addressValidationLabel" managed="false" styleClass="error-label" text="" visible="false" />

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="clearComposeButton" onAction="#onClearComposeClick" styleClass="btn" text="Pulisci" />
                                        <Button fx:id="sendButton" defaultButton="true" onAction="#onSendClick" styleClass="btn-primary" text="Invia" />
                                    </HBox>
                                </VBox>
                            </Tab>

                        </tabs>
                    </TabPane>
                </VBox>

            </items>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="0.0" />
            </padding>
        </SplitPane>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="bottom-bar">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="0.0" />
            </padding>
            <Label styleClass="strong" text="Stato:" />
            <Label fx:id="statusBarLabel" text="Pronto." />
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="busyIndicator" managed="false" prefHeight="18.0" prefWidth="18.0" visible="false" />
        </HBox>
    </bottom>

</BorderPane>
